    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.2"
  }
}
