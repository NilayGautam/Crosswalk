{
  "name": "@crosswalk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CROSSWALK_PUBLIC_URL=http://localhost:3210 CROSSWALK_WEB_DIST=none tsx watch src/index.ts",
